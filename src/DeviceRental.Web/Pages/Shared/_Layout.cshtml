@inject DemoCurrentUserContext DemoUserContext
@{
    var currentUser = DemoUserContext.GetCurrentUser(User);
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    var isAuthPage = currentPage is "/Account/Login" or "/Account/Register" or "/Account/ForgotPassword" or "/Account/VerifyEmail" or "/Account/ResetPassword";
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 测试设备台账</title>
    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/css/device-desk.css" />
</head>
<body class="@(isAuthPage ? "auth-shell" : null)">
    <a class="skip-link" href="#main-content">跳至主要内容</a>
    <header class="site-header">
        <nav class="site-nav" aria-label="主导航">
            <a class="brand" asp-page="/Index" aria-label="测试设备台账首页">
                <span class="brand-mark" aria-hidden="true"><span></span></span>
                <span>测试设备台账<small>Device Desk</small></span>
            </a>
            <div class="nav-links">
                <a asp-page="/Index" aria-current="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "page" : null)">设备</a>
                <a asp-page="/Loans" aria-current="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Loans" ? "page" : null)">借用记录</a>
                <a asp-page="/Privacy">借用说明</a>
                @if (currentUser.IsAdministrator)
                {
                    <a asp-page="/Admin/Devices">设备维护</a>
                    <a asp-page="/Admin/Policy">借期策略</a>
                }
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form method="post" asp-page="/Account/Logout" class="nav-logout-form">
                        <button type="submit" class="nav-logout">退出</button>
                    </form>
                }
                else
                {
                    <a asp-page="/Account/Login">登录</a>
                }
            </div>
            <span class="nav-user"><strong>@currentUser.DisplayName</strong><small>@currentUser.RoleDisplayName</small></span>
        </nav>
    </header>
    <main id="main-content" class="main-content" tabindex="-1">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <span>测试设备台账 · 内部测试组</span>
        <span>开放时间：09:00–19:00（上海时间）</span>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
