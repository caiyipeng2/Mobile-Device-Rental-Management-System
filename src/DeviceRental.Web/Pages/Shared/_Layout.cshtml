<!DOCTYPE html>
<html lang="zh-CN" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 手机借用管理系统</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="min-h-full bg-slate-50 text-slate-950 antialiased">
    <a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-white focus:px-4 focus:py-3 focus:outline focus:outline-2 focus:outline-emerald-700"
       href="#main-content">跳至主要内容</a>
    <header class="border-b border-slate-200 bg-white">
        <nav class="mx-auto flex min-h-16 max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8"
             aria-label="主导航">
            <a class="text-base font-semibold text-slate-950 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-700"
               asp-area="" asp-page="/Index">手机借用管理系统</a>
            <div class="flex items-center gap-4 text-sm">
                <a class="text-slate-700 hover:text-slate-950 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-700"
                   asp-area="" asp-page="/Index">设备</a>
                <a class="text-slate-700 hover:text-slate-950 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-700"
                   asp-area="" asp-page="/Privacy">隐私</a>
            </div>
        </nav>
    </header>
    <main id="main-content" class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 lg:px-8" tabindex="-1">
        @RenderBody()
    </main>
    <footer class="border-t border-slate-200 bg-white">
        <div class="mx-auto max-w-7xl px-4 py-5 text-sm text-slate-600 sm:px-6 lg:px-8">
            &copy; 2026 手机借用管理系统
        </div>
    </footer>

    <script src="~/vendor/htmx/htmx.min.js" defer></script>
    <script src="~/vendor/lucide/lucide.min.js" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
