@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "找回密码";
}

<section class="auth-page" aria-labelledby="forgot-password-title">
    <div class="auth-card">
        <p class="eyebrow">账户安全</p>
        <h1 id="forgot-password-title">找回密码</h1>
        <p class="page-description">输入注册邮箱，我们会发送一封有效期 30 分钟的重置邮件。</p>
        <form method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <label asp-for="Input.Email"></label>
            <input asp-for="Input.Email" autocomplete="email" inputmode="email" />
            <span asp-validation-for="Input.Email" class="field-error"></span>
            <button class="button button-primary" type="submit">发送重置邮件</button>
        </form>
        @if (Model.ResultMessage is not null)
        {
            <p class="notice notice-info" role="status">@Model.ResultMessage</p>
        }
        <p class="auth-link"><a asp-page="/Account/Login">返回登录</a></p>
    </div>
</section>
