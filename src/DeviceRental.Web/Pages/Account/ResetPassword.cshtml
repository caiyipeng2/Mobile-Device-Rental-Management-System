@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "重置密码";
}

<section class="auth-page" aria-labelledby="reset-password-title">
    <partial name="_AuthAside" />
    <div class="auth-card">
        <p class="eyebrow">账户安全</p>
        <h1 id="reset-password-title">重置密码</h1>
        @if (Model.ResultMessage is not null)
        {
            <p class="notice @(Model.IsSuccess ? "notice-success" : "notice-danger")" role="status">@Model.ResultMessage</p>
        }
        @if (!Model.IsSuccess)
        {
            <form method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" autocomplete="email" inputmode="email" />
                <span asp-validation-for="Input.Email" class="field-error"></span>
                <input asp-for="Input.Token" type="hidden" />
                <label asp-for="Input.NewPassword"></label>
                <input asp-for="Input.NewPassword" autocomplete="new-password" />
                <span asp-validation-for="Input.NewPassword" class="field-error"></span>
                <label asp-for="Input.ConfirmPassword"></label>
                <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
                <button class="button button-primary" type="submit">更新密码</button>
            </form>
        }
        <div class="auth-links">
            <p class="auth-link"><a asp-page="/Account/Login">返回登录</a></p>
        </div>
    </div>
</section>
